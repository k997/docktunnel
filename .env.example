# DockTunnel Environment Configuration
# Copy this file to .env and fill in your values.
#
# 所有环境变量使用 DOCKTUNNEL_ 前缀 + 配置路径（点转下划线），
# 例如 cloudflare.accountId → DOCKTUNNEL_CLOUDFLARE_ACCOUNT_ID。
# 环境变量优先级高于配置文件。

# Cloudflare Configuration
DOCKTUNNEL_CLOUDFLARE_ACCOUNT_ID=your-account-id-here
DOCKTUNNEL_CLOUDFLARE_API_TOKEN=your-api-token-here
DOCKTUNNEL_CLOUDFLARE_TUNNEL_NAME=DockTunnel

# Optional: Specify existing tunnel ID
# DOCKTUNNEL_CLOUDFLARE_TUNNEL_ID=your-tunnel-id-here

# Optional: Cloudflare API behavior
# DOCKTUNNEL_CLOUDFLARE_CATCH_ALL=http_status:404
# DOCKTUNNEL_CLOUDFLARE_RATE_LIMIT=10
# DOCKTUNNEL_CLOUDFLARE_MAX_RETRIES=3
# DOCKTUNNEL_CLOUDFLARE_RETRY_DELAY=1s
# DOCKTUNNEL_CLOUDFLARE_MAX_RETRY_DELAY=30s

# Logging Configuration
DOCKTUNNEL_LOG_LEVEL=info
DOCKTUNNEL_LOG_FORMAT=text

# Controller Configuration (optional)
# DOCKTUNNEL_CONTROLLER_FLAPPING_WINDOW=60s
# DOCKTUNNEL_CONTROLLER_FLAPPING_THRESHOLD=5
# DOCKTUNNEL_CONTROLLER_COOLING_PERIOD=300s
# DOCKTUNNEL_CONTROLLER_MAX_COOLING_PERIOD=1800s
# DOCKTUNNEL_CONTROLLER_DEBOUNCE_DURATION=2s
# DOCKTUNNEL_CONTROLLER_RECONCILE_ENABLED=true
# DOCKTUNNEL_CONTROLLER_RECONCILE_INTERVAL=120s

# Cleanup Configuration (optional)
# 默认 false：进程崩溃/重启时拆 DNS 会让外部域名短暂不可达
# DOCKTUNNEL_CLEANUP_ON_EXIT=false
# DOCKTUNNEL_CLEANUP_STRATEGY=graceful-cleanup
# DOCKTUNNEL_CLEANUP_TIMEOUT=30s
# DOCKTUNNEL_CLEANUP_STATE_FILE=/var/lib/docktunnel/state.bin

# Compensation Queue (optional)
# DOCKTUNNEL_COMPENSATION_INITIAL_DELAY=30s
# DOCKTUNNEL_COMPENSATION_MAX_DELAY=30m
# DOCKTUNNEL_COMPENSATION_MAX_RETRIES=10
# DOCKTUNNEL_COMPENSATION_POLL_INTERVAL=30s
# DOCKTUNNEL_COMPENSATION_MAX_QUEUE_SIZE=1000

# State Persistence (optional)
# DOCKTUNNEL_PERSISTENCE_BACKUP_COUNT=3
# DOCKTUNNEL_PERSISTENCE_VALIDATE_ON_LOAD=true

# Diagnostics / Metrics HTTP server (optional)
# DOCKTUNNEL_SERVER_BIND_ADDR=127.0.0.1
# DOCKTUNNEL_SERVER_PORT=9100
# DOCKTUNNEL_SERVER_DEBUG_TOKEN=            # 非空时 /debug/state 需要 Bearer token

# Defaults (optional)
# DOCKTUNNEL_DEFAULTS_SCHEME=http
# DOCKTUNNEL_DEFAULTS_PORT=80
# DOCKTUNNEL_DEFAULTS_PATH=
