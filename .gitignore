.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Go build artifacts
*.test
*.exe
dist/
build/

# Development documentation
.claude/
.specify/
specs/
